{
  "name": "ourspace-co-op",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ourspace-co-op-db",
      "database_id": "555020cd-83f5-4547-9e08-a822d3884d17"
    }
  ],

  "triggers": {
    "crons": ["0 19 * * *"]
  }
}
